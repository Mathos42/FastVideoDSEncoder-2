<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Authors>Gericom</Authors>
    <Product>FastVideoDS Encoder</Product>
    <Nullable>disable</Nullable>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>Gericom.FastVideoDSEncoder</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Prefer32Bit>false</Prefer32Bit>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="FFmpeg.AutoGen" Version="9.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gericom.FastVideoDS\Gericom.FastVideoDS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="x64\" />
  </ItemGroup>

  <ItemGroup>
    <None Update="x64\avcodec-63.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="x64\avdevice-63.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="x64\avfilter-12.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="x64\avformat-63.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="x64\avutil-61.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="x64\swresample-7.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="x64\swscale-10.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="x64\ffmpeg.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Création de l'arborescence finale de FastVideoDSEncoder lors du build Release -->
  <Target Name="OrganiserDossierSortie" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <DossierFastVideoDSEncoder>$(MSBuildProjectDirectory)\FastVideoDSEncoder</DossierFastVideoDSEncoder>
    </PropertyGroup>
    
    <MakeDir Directories="$(DossierFastVideoDSEncoder)" />
    <MakeDir Directories="$(DossierFastVideoDSEncoder)\bin" />
    <MakeDir Directories="$(DossierFastVideoDSEncoder)\Encodes" />
    <MakeDir Directories="$(DossierFastVideoDSEncoder)\Videos" />
    
    <Copy SourceFiles="FastVideoDS.bat" DestinationFolder="$(DossierFastVideoDSEncoder)" />
    <Copy SourceFiles="Mettre Vos Videos Ici - PutYourVideosHere.txt" DestinationFolder="$(DossierFastVideoDSEncoder)" />
    
    <ItemGroup>
      <FichiersCompiles Include="$(TargetDir)\**\*.*" Exclude="$(TargetDir)\FastVideoDS.bat;$(TargetDir)\Mettre Vos Videos Ici - PutYourVideosHere.txt" />
    </ItemGroup>
    
    <Copy SourceFiles="@(FichiersCompiles)" DestinationFolder="$(DossierFastVideoDSEncoder)\bin\%(RecursiveDir)" />
  </Target>

</Project>
